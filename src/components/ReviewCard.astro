---
interface Props {
  href: string;
  title: string;
  creator: string;
  year: number;
  rating: number;
  excerpt: string;
}

const { href, title, creator, year, rating, excerpt } = Astro.props;
---

<a href={href} class="reveal" style="text-decoration: none; color: inherit; display: block; padding: 28px 0; border-bottom: 1px solid var(--line);">
  <div class="grid-12" style="align-items: baseline;">
    <div style="grid-column: 1 / 9;">
      <p class="eyebrow" style="margin: 0 0 6px;">{creator} — {year}</p>
      <h3 style="font-size: 24px;">{title}</h3>
      <p style="color: var(--ink-soft); margin: 8px 0 0; max-width: 46ch;">{excerpt}</p>
    </div>
    <div style="grid-column: 10 / 13; text-align: right;">
      <span class="rating" style="font-size: 40px; line-height: 1;">{rating}</span><span style="color: var(--ink-soft); font-family: var(--font-mono); font-size: 14px;">/10</span>
    </div>
  </div>
</a>