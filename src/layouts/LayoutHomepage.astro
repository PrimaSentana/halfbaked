---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal reviews of movies and music.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.jpg">
    <meta name="description" content={description} />
  </head>
  <body>
    <hr class="rule" />

    <main>
      <slot />
    </main>

    <hr class="rule" />
    <Footer/>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.1,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true
      });

      lenis.on('scroll', ScrollTrigger.update)

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0)

      const items = gsap.utils.toArray<HTMLElement>('.reveal');
      items.forEach((el, i) => {
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          delay: (i % 6) * 0.05,
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            once: true,
          },
        });
      });

      const titleItems = gsap.utils.toArray<HTMLElement>('.title-item');
      const titleList = document.querySelector('.title-list')
      const bgImages = gsap.utils.toArray<HTMLElement>('.bg-image');
      const siteHeader = document.querySelector('.site-header');

      titleItems.forEach((item) => {
        item.addEventListener('mouseenter', () => {
          siteHeader?.classList.add('is-light');
          titleList?.classList.add('is-light');
          const index = item.dataset.index;
          bgImages.forEach((bg) => {
            const isTarget = bg.dataset.index === index;
            gsap.to(bg, {
              opacity: isTarget ? 1 : 0,
              duration: 0.3,
              ease: 'power2.out',
            });
          });
        });
        item.addEventListener('mouseleave', () => {
          siteHeader?.classList.add('is-light');
        });
      });
    </script>
  </body>
</html>
