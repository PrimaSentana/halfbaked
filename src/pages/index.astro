---
import LayoutHomepage from '../layouts/LayoutHomepage.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';

const movies = await getCollection('movies');
const music = await getCollection('music');

const all = [
  ...movies.map((e) => ({ ...e, type: 'movies' as const })),
  ...music.map((e) => ({ ...e, type: 'music' as const })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = all.slice(0, 5);
const rest = all.slice(0, 10);
---

<LayoutHomepage title="Halfbaked — movie and music reviews">
  <section class="a24-hero">
    <Navbar/>
    <div class="bg-layer">
      {latest.map((entry, i) => (
        <div
          class="bg-image"
          data-index={i}
          style={`background-image: url(${entry.data.cover});`}
        ></div>
      ))}
    </div>

    <ul class="title-list">
      {latest.map((entry, i) => (
        <li>
          <a href={`/${entry.type}/${entry.id}`} class="title-item" data-index={i}>
            <span class="title-text">{entry.data.title}</span>
            <span class="title-year">{entry.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <hr class="rule" />

  <section class="wrap" style="padding: 48px 0;">
    <div class="grid-12">
      <div style="grid-column: 1 / 4;">
        <p class="eyebrow reveal">Recent</p>
      </div>
      <div style="grid-column: 4 / 13;">
        {rest.map((entry) => (
          <ReviewCard
            href={`/${entry.type}/${entry.id}`}
            title={entry.data.title}
            creator={entry.data.creator}
            year={entry.data.year}
            rating={entry.data.rating}
            excerpt={entry.data.excerpt}
          />
        ))}
      </div>
    </div>
  </section>
</LayoutHomepage>
