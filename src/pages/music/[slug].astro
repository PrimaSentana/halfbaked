---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const music = await getCollection('music');
  return music.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} — Halfbaked`} description={entry.data.excerpt}>
  <article class="wrap" style="padding: 48px 0 80px;">
    <div class="grid-12">
      <div style="grid-column: 1 / 9;">
        <p class="eyebrow reveal" style="margin-bottom: 12px;">Music</p>
        <h1 class="reveal" style="font-size: clamp(36px, 6vw, 64px); line-height: 1.02;">{entry.data.title}</h1>
        <p class="eyebrow" style="margin-top: 20px;">{entry.data.creator} — {entry.data.year}</p>
      </div>
      <div style="grid-column: 10 / 13; text-align: right;">
        <span class="rating" style="font-size: 72px; line-height: 1;">{entry.data.rating}</span>
        <div style="color: var(--ink-soft); font-family: var(--font-mono); font-size: 14px;">out of 10</div>
      </div>
    </div>

    <hr class="rule" style="margin: 40px 0;" />

    <div class="grid-12">
      <div class="reveal" style="grid-column: 1 / 8; font-size: 18px; line-height: 1.8;">
        <Content />
      </div>
      <div style="grid-column: 9 / 13;">
        <p class="eyebrow">Tags</p>
        <p style="color: var(--ink-soft); margin-top: 8px;">{entry.data.tags.join(', ')}</p>
      </div>
    </div>

    <hr class="rule" style="margin: 48px 0 24px;" />
    <a href="/music" class="eyebrow" style="text-decoration: none;">&larr; Back to music</a>
  </article>
</Layout>
